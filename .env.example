# Copy to .env and replace only the providers you use. Never commit .env.
#
# A provider registers ONLY if its key variable is set (glc/providers.py). A
# missing or misspelled name fails SILENTLY: the gateway starts fine and just
# omits that provider, so the first symptom is `unknown provider 'x'` on a call
# that should have worked. After editing, restart the gateway and check
#   curl -s localhost:8111/v1/providers
# lists what you expect — load_dotenv() runs at import, so a gateway started
# before you edited .env keeps serving the old environment forever.

GEMINI_API_KEY_1=replace-me
GEMINI_API_KEY_2=replace-me
# ...up to GEMINI_API_KEY_16 (MAX_GEMINI_KEYS). Numbered slots become a pool of
# gemini_1..gemini_N. A single bare GEMINI_API_KEY is accepted as a 1-member pool.

# --- Other providers. Omit any you do not have a key for. -------------------
# TWO NAMES ARE NOT WHAT YOU WOULD GUESS, and both fail silently if guessed:
#   OPEN_ROUTER_API_KEY  — underscore between OPEN and ROUTER, though the
#                          provider is called `openrouter` everywhere else.
#   GITHUB_ACCESS_TOKEN  — a GitHub PAT with Models access, NOT GITHUB_API_KEY.
GROQ_API_KEY=replace-me
CEREBRAS_API_KEY=replace-me
NVIDIA_API_KEY=replace-me
OPEN_ROUTER_API_KEY=replace-me
GITHUB_ACCESS_TOKEN=replace-me
# OpenAI itself, not one of the servers that merely speak its dialect. This is
# the only provider here that is never free at any tier, and the only one whose
# models bill frontier rates — set it deliberately, not by reflex.
OPENAI_API_KEY=replace-me

# Logical provider order. Numbered Gemini slots are expanded automatically.
# Entries whose provider did not register are skipped, so listing a provider
# here does NOT make it available — only its key does.
LLM_ORDER=ollama,gemini,nvidia,groq,cerebras,openrouter,github,openai
GLC_PORT=8111

# --- Default model per provider (all OPTIONAL) ------------------------------
# These set the model used when a request does not pin one. A caller that sends
# an explicit "model" in the /v1/chat body always wins, so a client with its own
# ladder (e.g. S15Code's config/tiers.yaml) does not need any of these set.
# Shown below is the built-in default each falls back to.
#
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_MODEL=zai-glm-4.7
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# GITHUB_MODEL=openai/gpt-4.1-mini
#
# The NVIDIA default is stale: deepseek-ai/deepseek-v3.2 returns HTTP 404.
# Set this explicitly if you use the nvidia provider at all.
# NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
#
# OpenAI's gpt-5.6 family, cheapest first: luna ($0.20/$1.20 per Mtok), terra
# ($2.00/$12.00), sol ($5.00/$30.00). The bare alias `gpt-5.6` routes to SOL, the
# dearest of the three — name the variant you mean. Terra is the default because
# it is what S15Code's frontier rung bills against.
# OPENAI_MODEL=gpt-5.6-terra
#
# Ollama registers only when OLLAMA_MODEL is set — there is no default.
# OLLAMA_MODEL=gemma4:31b
# OLLAMA_URL=http://localhost:11434

# --- Ledger -----------------------------------------------------------------
# Give this repo its own ledger. The default ~/.glc/gateway.sqlite is shared by
# every course generation, and an older schema there surfaces as a 500 on
# /v1/chat AFTER the provider call already succeeded — i.e. you pay, then fail.
# GLC_GATEWAY_DB=$HOME/.glc/glc_v4/gateway.sqlite

# --- OpenTelemetry -> Jaeger (docker-compose.observability.yml) --------------
# OTel *base* URL — glc appends /v1/traces itself. Use 4318 (OTLP/HTTP); gRPC
# (4317) would need opentelemetry-exporter-otlp-proto-grpc, not a declared dep.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=glc-v4-gateway
# GLC_TRACE_UI=http://localhost:16686
#
# Prompt/completion text on spans: the highest-PII payload the gateway handles,
# so the shipped default stays OFF. Opt in only against a localhost collector
# holding test data; never point it at a shared collector.
# GLC_OTEL_CAPTURE_CONTENT=1
